# Database (local Docker or Azure PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spc"

# NextAuth — generate with: npx auth secret
AUTH_SECRET="your-secret-here"

# Resend (email magic links) — get from resend.com
AUTH_RESEND_KEY="re_xxxx"
AUTH_RESEND_FROM="noreply@auxtechna.com"

# Microsoft Entra ID — register app at portal.azure.com
AUTH_MICROSOFT_ENTRA_ID_ID="your-client-id"
AUTH_MICROSOFT_ENTRA_ID_SECRET="your-client-secret"
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID="organizations"

# Google OAuth — console.cloud.google.com
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"
